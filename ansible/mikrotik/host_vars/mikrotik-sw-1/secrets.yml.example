---
# Copy this file to secrets.yml and fill in real values
# secrets.yml is excluded from git via .gitignore

# RouterOS API password (used for BGP config via community.routeros.api)
mikrotik_api_password: "CHANGEME"

# Home Assistant read-only user — only used if ha-monitor has to be
# (re)created; an existing user's password is never changed.
ha_monitor_password: "CHANGEME"
